{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sandbox-compare",
  "account_id": "62025cd9ce8dabd2cb6651b6e058d41a",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sandbox-compare",
    "database_id": "9fca2745-d7c0-473e-91ae-d86faebe7088",
    "migrations_dir": "migrations"
  }],
  "workflows": [{
    "binding": "BENCHMARK",
    "name": "sandbox-compare-benchmark",
    "class_name": "BenchmarkWorkflow"
  }],
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "secrets": { "required": ["DAYTONA_API_KEY", "ADMIN_TOKEN"] },
  "vars": {
    "DAYTONA_API_URL": "https://app.daytona.io/api",
    "DAYTONA_TOOLBOX_URL": "https://proxy.app.daytona.io/toolbox"
  }
}
